# Cole no Vercel → Project → Settings → Environment Variables
# Troque os valores entre <...> antes de salvar.

NODE_ENV=production

# Postgres (Neon, Supabase, Railway, etc.) — SSL em produção
DATABASE_URL=<postgresql://USER:PASSWORD@HOST:5432/dharma?sslmode=require>

# URL pública deste deploy (sem barra no final)
PUBLIC_API_URL=<https://dharma-api-mu.vercel.app>

COOKIE_SECURE=true
SESSION_MAX_HOURS=168

# 32+ caracteres aleatórios (openssl rand -hex 32)
CONFIG_ENCRYPT_KEY=<cole_uma_chave_hex_64_chars>

# Front Next.js (outro projeto Vercel)
DHARMA_PUBLIC_URL=<https://seu-dharma.vercel.app>
ADMIN_PUBLIC_URL=<https://seu-admin.vercel.app>
REGISTRATION_PUBLIC_URL=<https://seu-cadastro.vercel.app>
DOC_SIGN_PUBLIC_URL=<https://seu-docsign.vercel.app>

# Arquivos: obrigatório S3 ou GCS na Vercel (local não persiste)
FILES_DRIVER=s3
FILES_KEY_PREFIX=dharma/
S3_BUCKET=<seu-bucket>
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<key>
S3_SECRET_ACCESS_KEY=<secret>

# Opcional: só se o browser chamar a API direto (sem proxy Next)
# CORS_ORIGIN=<https://seu-dharma.vercel.app>

# Vercel: schema pesado no cold start — ligue só após 1º deploy ok
# RUN_SCHEMA_ENSURE=1

# --- Fallback de integrações (o normal é configurar no Admin → Serviços externos) ---
